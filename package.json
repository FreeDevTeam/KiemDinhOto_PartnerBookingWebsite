  "devDependencies": {
    "copyright-header": "^0.4.6",
    "husky": "^8.0.2",
    "prettier": "^2.8.1"
  },
  "scripts": {
    "deploy-zalo-app": "npm run build && node deployZApp.js",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "formatAll": "./node_modules/.bin/prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\" & ./node_modules/.bin/copyright-header copyright-header --fix --copyrightHolder 'TORITI LIMITED 2022'",
    "format": "./node_modules/.bin/prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "autobuild": "npx @chaunnt/reactjs_buildpackageandnotify",
    "postinstall": "husky install"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "yarn format",
      "git add"
    ]
  }
}
