    "react-aspect-ratio": "^1.1.6",
    "react-dom": "^18.2.0",
    "react-i18next": "^11.12.0",
    "react-router-dom": "^5.2.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.8.0",
    "react-slick": "^0.29.0",
    "jwt-decode": "^3.1.2",
    "sass": "^1.69.5",
    "slick-carousel": "^1.8.1",
    "styled-components": "^5.2.0",
