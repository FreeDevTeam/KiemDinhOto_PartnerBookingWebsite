# Apikey gọi booking api (chỉ sử dụng khi debug)
REACT_APP_BOOKING_API_KEY=000c4646-a44d-4808-9a8b-a68be4ec3af5
# ApiKey để gọi một số request đặc biệt ví dụ như: reset password (chỉ sử dụng khi debug hoặc Zalo)
REACT_APP_SYSTEM_API_KEY=
# gọi phần request đến zalo lấy thông tin user = 1 hoặc 0
REACT_APP_ZALO_AUTH_ENABLE=0
# lay API key danh cho TTDK_ZALO_MINI_APP de goi API TTDK
ZALO_USER_TOKEN=
# Secrect key của zalo miniapp
REACT_APP_ZALO_SECRECT_KEY=
# key của saladin
ENV_REACT_APP_BOOKING_API_KEY='fe58f4e7-29ac-4ade-86b1-d51a3b0602a5'
ENV_REACT_WEB_SALADIN="https://saladin.ttdk.com.vn/"
# key mã hoá
REACT_APP_RUNTIME_MODE=developer
REACT_APP_KEY_PAYLOAD=xxx
REACT_APP_ENCRYPT_SECRET_KEY=ENCRYPT_SECRET_KEY
REACT_APP_MINIAPP_GTELPAY=0
# Layout cho trang chủ
REACT_APP_DEFAULT_HOME_LAYOUT=

# Trường hợp cần miniapp có home để back về bằng cách gọi dấu x miniapp
REACT_APP_HOME_MINIAPP_HEADER_TITLE=Giao thông số
REACT_APP_HOME_MINIAPP_HEADER_EXPAND=false


